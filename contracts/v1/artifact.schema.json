{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/devops/e2/v1/artifact.schema.json",
  "title": "Artifact reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "type", "uri", "media_type", "producer_job_id", "sha256"],
  "properties": {
    "artifact_id": { "type": "string", "pattern": "^[a-z0-9-]{3,64}$" },
    "type": {
      "enum": ["DOCKERFILE", "BUILD_LOG", "ACTUAL_GRAPH", "DECLARED_GRAPH", "ERROR_REPORT", "GIT_PATCH", "REPAIR_REPORT"]
    },
    "uri": { "type": "string", "pattern": "^artifact://[A-Za-z0-9._/-]+$" },
    "media_type": { "type": "string", "minLength": 3 },
    "producer_job_id": { "type": "string", "pattern": "^job-[a-z0-9-]{3,64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
